{
  "name": "MeshCore Bot",
  "slug": "meshcore-bot",
  "version": "1.0.0",
  "description": "MeshCore bot for mesh radio networks",
  "url": "https://github.com/lburais/hassio-addons/tree/master/meshcore-bot",
  "arch": ["aarch64", "amd64", "armv7"],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "stage": "experimental",
  "host_network": false,
  "uart": true,
  "usb": true,
  "map": ["addon_config:rw"],
  "ports": {
    "8080/tcp": 8080
  },
  "ports_description": {
    "8080/tcp": "Web viewer (if enabled in config.ini)"
  },
  "options": {
    "timezone": "Europe/Paris"
  },
  "schema": {
    "timezone": "str"
  }
}
