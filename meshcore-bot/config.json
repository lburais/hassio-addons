{
  "name": "MeshCore Bot",
  "slug": "meshcore-bot",
  "version": "1.0.4",
  "description": "MeshCore bot for mesh radio networks",
  "url": "https://github.com/lburais/hassio-addons/tree/master/meshcore-bot",
  "arch": [
    "aarch64",
    "amd64",
    "armv7"
  ],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "stage": "experimental",
  "host_network": false,
  "uart": true,
  "usb": true,
  "map": [
    "addon_config:rw"
  ],
  "ports": {
    "8080/tcp": 8080
  },
  "ports_description": {
    "8080/tcp": "Web viewer (if enabled in config.ini)"
  },
  "options": {
    "timezone": "Europe/Paris",
    "connection_type": "serial",
    "serial_port": "/dev/ttyAMA0",
    "bot_name": "FR06-Laurent-C6L-Bot"
  },
  "schema": {
    "timezone": "str",
    "connection_type": "list(serial|ble|tcp)",
    "serial_port": "str",
    "bot_name": "str"
  },
  "ingress": true,
  "ingress_port": 8080,
  "panel_icon": "mdi:radio-tower",
  "panel_title": "MeshCore Bot",
  "webui": "http://[HOST]:[PORT:8080]"
}
