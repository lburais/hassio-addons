{
  "name": "MeshCore Bot",
  "slug": "meshcore-bot",
  "version": "1.0.6",
  "description": "MeshCore bot for mesh radio networks",
  "url": "https://github.com/lburais/hassio-addons/tree/master/meshcore-bot",
  "arch": [
    "aarch64",
    "amd64",
    "armv7"
  ],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "stage": "experimental",
  "host_network": false,
  "uart": true,
  "usb": true,
  "map": [
    "addon_config:rw"
  ],
  "ports": {
    "7777/tcp": 7777
  },
  "ports_description": {
    "7777/tcp": "Web viewer (if enabled in config.ini)"
  },
  "ingress": true,
  "ingress_port": 7777,
  "panel_icon": "mdi:radio-tower",
  "panel_title": "MeshCore Bot",
  "webui": "http://[HOST]:[PORT:7777]"
}
